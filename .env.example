APP_ENV=development
POSTGRES_DB=sales_bot
POSTGRES_USER=sales_bot
POSTGRES_PASSWORD=
DATABASE_URL=
PUBLIC_BASE_URL=http://localhost:8000

# Secrets: replace before any non-local launch.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_POLL_TIMEOUT_SECONDS=20
TELEGRAM_DROP_PENDING_UPDATES=false
LOCAL_AUTO_APPROVE_FIRST_USER=true
# Optional safety pin. If empty, the first private user who sends /start becomes owner.
LOCAL_OWNER_TELEGRAM_USER_ID=
ADMIN_USERNAME=access_admin
ADMIN_PASSWORD=
SAFETY_IDENTIFIER_SECRET=
OPENAI_API_KEY=

# mock makes the complete local demo deterministic and free.
AGENT_BACKEND=mock
OPENAI_MODEL=gpt-5.6-luna
OPENAI_PROMPT_ID=
OPENAI_PROMPT_VERSION=
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_INPUT_USD_PER_MTOK=2.00
OPENAI_CACHED_INPUT_USD_PER_MTOK=0.20
OPENAI_OUTPUT_USD_PER_MTOK=12.00

CONTEXT_TTL_HOURS=24
CONTEXT_MAX_MESSAGES=12
CONTEXT_MAX_CHARS=24000
MAX_MESSAGE_CHARS=12000
JOB_PAYLOAD_TTL_HOURS=24
MAX_JOB_ATTEMPTS=3
WORKER_POLL_SECONDS=1
GLOBAL_DAILY_REQUEST_LIMIT=1000
GLOBAL_DAILY_COST_LIMIT_USD=50

# Non-secret URLs and app metadata live in config/mcp_servers.json.
# MCP_SERVERS_JSON can override that file. Fill allowed_tools only after live discovery.
# OAuth access tokens are read from environment variables, never from JSON.
MCP_SERVERS_JSON=
MCP_SERVERS_FILE=config/mcp_servers.json
MODUSBI_MCP_OAUTH_CLIENT_ID=
JIRA_MCP_ACCESS_TOKEN=
BITRIX_MCP_ACCESS_TOKEN=
KTALK_MCP_ACCESS_TOKEN=
